    "\\b(xai-[A-Za-z0-9_\\-]{16,})\\b",
    "\\b(gsk_[A-Za-z0-9_\\-]{16,})\\b",
    "\\b(ghp_[A-Za-z0-9_]{30,})\\b",
    "\\b(xox[baprs]-[A-Za-z0-9-]{10,})\\b",
    "\\b(AKIA[0-9A-Z]{16})\\b",
