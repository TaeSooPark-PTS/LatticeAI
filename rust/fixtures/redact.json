    "-----BEGIN [A-Z ]+PRIVATE KEY-----[\\s\\S]+?-----END [A-Z ]+PRIVATE KEY-----"
  ],
  "source": "latticeai.core.security.redact_secret_text + latticeai.models.router.branding.normalize_branding",
  "telegram_patterns": [
    "\\bbot(\\d{5,20}):[A-Za-z0-9_-]{8,}\\b",
    "(?<![A-Za-z0-9_:-])(\\d{5,20}):[A-Za-z0-9_-]{8,}(?![A-Za-z0-9_-])"
  ]
