  "modes": [
    "strict",
    "trusted",
    "bypass"
  ],
  "pinned_env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "plans": [
    {
      "governed": [],
      "key": "empty",
      "plan_flag": false,
      "steps": []
