  "tree": [
    {
      "content": "top secret\n",
      "kind": "outside",
      "path": "outside_secret.txt"
    },
    {
      "kind": "dir",
      "path": "notes"
    },
    {
      "content": "alpha\nbeta\ngamma\n",
      "kind": "file",
      "path": "notes/a.txt"
    },
    {
      "kind": "dir",
      "path": "a b"
    },
    {
      "content": "spaced\n",
      "kind": "file",
      "path": "a b/c.txt"
    },
    {
      "content": "quoted\n",
      "kind": "file",
      "path": "quoted name.txt"
    },
    {
      "kind": "dir",
      "path": "노트"
    },
    {
      "content": "한글\n",
      "kind": "file",
      "path": "노트/메모.txt"
    },
    {
      "kind": "dir",
      "path": "sub"
    },
    {
      "content": "inner\n",
      "kind": "file",
      "path": "sub/inner.txt"
    },
    {
      "content": "backslash\n",
      "kind": "file",
      "path": "a\\b"
    },
    {
      "kind": "symlink",
      "path": "inside_link",
      "target": "notes/a.txt"
    },
    {
      "kind": "symlink",
      "path": "escape_link",
      "target": "../outside_secret.txt"
    },
    {
      "count": 3000,
      "kind": "lines",
      "path": "big.txt"
    }
  ],
  "which_paths": [
    "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"
  ]
}
