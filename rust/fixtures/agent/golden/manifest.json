    {
      "governed": [],
      "key": "reads_only",
      "plan_flag": false,
      "steps": [
        {
          "action": "read_file"
        },
        {
          "action": "list_dir"
        }
      ]
    },
    {
      "governed": [],
      "key": "reads_plan_flag",
      "plan_flag": true,
      "steps": [
        {
          "action": "read_file"
        }
      ]
    },
    {
      "governed": [],
      "key": "workspace_writes",
      "plan_flag": false,
      "steps": [
        {
          "action": "write_file"
        },
        {
          "action": "edit_file"
        },
        {
          "action": "todo_write"
        }
      ]
    },
    {
      "governed": [
