{
  "arg_variants": {
    "benign_path": {
      "path": "notes/todo.md"
    },
    "blocked_prefix": {
      "path": "/etc/hosts"
    },
    "existing_path": {
      "path": "notes/existing.md"
    },
    "filename_doc": {
      "filename": "report.docx"
    },
    "home_tilde_slash": {
      "path": "~/"
    },
    "long_path": {
      "path": "deep/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.md"
    },
    "none": {},
