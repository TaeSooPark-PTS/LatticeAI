{
  "constants": {
    "compact_max_params_b": 4.0,
    "file_create_actions": [
      "create_docx",
      "create_pdf",
      "create_pptx",
      "create_web_project",
      "create_xlsx",
      "edit_file",
      "write_file"
    ],
    "governed_tools": [
      "edit_file",
      "write_file"
    ],
    "max_retry": 3,
    "max_state_history": 200,
    "phase_budgets": {
      "execute_tokens": 4096,
      "memory_tokens": 256,
      "plan_tokens": 1024,
      "verify_tokens": 512
