      "knowledge_save",
      "knowledge_search",
      "knowledge_tree",
      "obsidian_save",
      "obsidian_search",
      "obsidian_tree"
    ],
    "transcript_budget": {
      "result_chars": 700,
      "verify_chars": 1200,
      "window": 8
    }
  },
  "normalization": [
    "the absolute workspace root becomes <AGENT_ROOT>",
    "keys named `at` are dropped (trace timestamps)",
