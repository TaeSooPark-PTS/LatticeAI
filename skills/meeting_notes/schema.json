{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "meeting_notes",
  "version": "1.0.0",
  "action": "write_file",
  "input": {
    "required": ["path", "content"],
    "optional": ["notes", "source_path"],
    "properties": {
      "path":        { "type": "string", "description": "저장할 노트 경로 (워크스페이스 상대 경로, .md)" },
      "content":     { "type": "string", "description": "결정사항/할 일/미해결 질문으로 정리된 마크다운 본문" },
      "notes":       { "type": "string", "description": "원본 회의 메모 (붙여넣기)" },
      "source_path": { "type": "string", "description": "원본 메모 파일 경로 (notes 대신 사용)" }
    }
  },
  "output": {
    "oneOf": [
      {
        "title": "success",
        "properties": {
          "success": { "const": true },
          "path":    { "type": "string" },
          "bytes":   { "type": "integer" }
        },
        "required": ["path"]
      },
      {
        "title": "failure",
        "properties": {
          "success": { "const": false },
          "error":   { "type": "string", "enum": ["INVALID_INPUT","FILE_NOT_FOUND","MODEL_NOT_LOADED"] },
          "message": { "type": "string" }
        },
        "required": ["success","error","message"]
      }
    ]
  },
  "evals": [
    {
      "id": "writes_a_note",
      "description": "정리된 노트를 워크스페이스에 저장한다",
      "input": {
        "path": "notes/meeting-notes-eval.md",
        "content": "# 회의 노트\n\n## 결정사항\n- 1분기 예산 1200만원 확정\n\n## 할 일\n- [ ] 예산안 공유 (담당 미정)\n\n## 미해결 질문\n- 2분기 계획 승인 일정\n"
      },
      "pass_criteria": "success == true"
    },
    {
      "id": "rejects_empty_input",
      "description": "경로 없이 호출하면 거절한다",
      "input": { "content": "x" },
      "pass_criteria": "success == false"
    }
  ]
}
