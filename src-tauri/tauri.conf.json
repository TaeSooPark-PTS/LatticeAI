{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice AI",
  "version": "4.6.1",
  "identifier": "ai.lattice.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run build:assets",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../static/app"
  },
  "app": {
    "windows": [
      {
        "title": "Lattice AI",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": [
      "../auto_setup.py",
      "../kg_schema.py",
      "../knowledge_graph.py",
      "../knowledge_graph_api.py",
      "../llm_router.py",
      "../local_knowledge_api.py",
      "../ltcai_cli.py",
      "../mcp_registry.py",
      "../p_reinforce.py",
      "../server.py",
      "../setup_wizard.py",
      "../telegram_bot.py",
      "../requirements.txt",
      "../latticeai",
      "../lattice_brain",
      "../tools",
      "../static"
    ],
    "icon": [
      "../static/icons/icon-192.png",
      "../static/icons/icon-512.png"
    ]
  }
}
