{
  "name": "ltcai",
  "version": "0.1.18",
  "description": "Lattice AI local MLX/cloud LLM workspace server",
  "homepage": "https://github.com/TaeSooPark-PTS/LatticeAI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaeSooPark-PTS/LatticeAI.git"
  },
  "bugs": {
    "url": "https://github.com/TaeSooPark-PTS/LatticeAI/issues"
  },
  "bin": {
    "ltcai": "bin/ltcai.js",
    "LTCAI": "bin/ltcai.js"
  },
  "scripts": {
    "start": "LTCAI",
    "dev": "python3 ltcai_cli.py --reload",
    "build:python": "python3 -m build",
    "check:python": "python3 -m py_compile ltcai_cli.py server.py knowledge_graph.py llm_router.py p_reinforce.py telegram_bot.py tools.py codex_telegram_bot.py",
    "test": "python3 -m pytest tests/ -v",
    "test:unit": "python3 -m pytest tests/unit/ -v",
    "test:integration": "python3 -m pytest tests/integration/ -v",
    "publish:npm": "npm publish --access public",
    "publish:pypi": "python3 -m twine upload dist/*"
  },
  "keywords": [
    "ltcai",
    "ai-assistant",
    "llm",
    "mlx",
    "local-ai",
    "agent",
    "mcp",
    "rag",
    "vscode"
  ],
  "license": "MIT",
  "private": false,
  "files": [
    "bin/ltcai.js",
    "LICENSE",
    "ltcai_cli.py",
    "server.py",
    "knowledge_graph.py",
    "llm_router.py",
    "p_reinforce.py",
    "telegram_bot.py",
    "tools.py",
    "codex_telegram_bot.py",
    "skills/",
    "tests/",
    "static/account.html",
    "static/chat.html",
    "static/admin.html",
    "static/graph.html",
    "static/manifest.json",
    "static/sw.js",
    "static/icons/",
    "docs/",
    "requirements.txt",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
