{
  "name": "ltcai",
  "version": "0.1.1",
  "description": "Lattice AI local MLX/cloud LLM workspace server",
  "bin": {
    "ltcai": "bin/ltcai.js",
    "LTCAI": "bin/ltcai.js"
  },
  "scripts": {
    "start": "LTCAI",
    "dev": "python3 ltcai_cli.py --reload",
    "build:python": "python3 -m build",
    "check:python": "python3 -m py_compile ltcai_cli.py server.py llm_router.py p_reinforce.py telegram_bot.py tools.py codex_telegram_bot.py",
    "publish:npm": "npm publish --access public",
    "publish:pypi": "python3 -m twine upload dist/*"
  },
  "keywords": [
    "ltcai",
    "llm",
    "mlx",
    "LTCAI"
  ],
  "license": "MIT",
  "private": false,
  "files": [
    "bin/ltcai.js",
    "LICENSE",
    "ltcai_cli.py",
    "server.py",
    "llm_router.py",
    "p_reinforce.py",
    "telegram_bot.py",
    "tools.py",
    "codex_telegram_bot.py",
    "static/index.html",
    "static/indexd.html",
    "static/admin.html",
    "requirements.txt",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
