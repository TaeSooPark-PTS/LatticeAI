# Existing local Lattice AI Telegram bot.
# Create a fresh token in BotFather and put it in .env, not in source code.
LATTICEAI_MODE=local
LATTICEAI_HOST=0.0.0.0
LATTICEAI_PORT=4825
LATTICEAI_REQUIRE_AUTH=true
# Comma-separated extra origins for browser clients outside localhost.
LATTICEAI_CORS_ALLOWED_ORIGINS=
LATTICEAI_AUTOLOAD_MODELS=true
LATTICEAI_ENABLE_TELEGRAM=true
LATTICEAI_ENABLE_GRAPH=true
LATTICEAI_ALLOW_LOCAL_MODELS=true
LATTICEAI_LOCAL_MODEL=mlx-community/gemma-4-26b-a4b-it-4bit
LATTICEAI_LOCAL_DRAFT_MODEL=mlx-community/gemma-4-26B-A4B-it-assistant-bf16
LATTICEAI_TELEGRAM_BOT_TOKEN=
# Auto Setup writes repaired binary paths here when a tool is installed outside
# the server process PATH, for example /opt/homebrew/bin on macOS.
LATTICEAI_EXTRA_PATH=
# Keep false unless you explicitly want chat messages containing /path or ~/path
# to inject local file contents into the model context.
LATTICEAI_AUTO_READ_CHAT_PATHS=false

# Public server mode. Use this on Render/Fly/Railway/VPS.
# LATTICEAI_MODE=public
# LATTICEAI_ENABLE_TELEGRAM=false
# LATTICEAI_ENABLE_GRAPH=false
# LATTICEAI_ALLOW_LOCAL_MODELS=false
# LATTICEAI_PUBLIC_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# New cloud Codex Telegram bot.
CODEX_TELEGRAM_BOT_TOKEN=

# OpenAI API key used by codex_telegram_bot.py.
OPENAI_API_KEY=
CODEX_OPENAI_MODEL=gpt-5.4

# Optional: allow the Codex bot to create GitHub issues.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Optional runtime files.
LATTICEAI_TELEGRAM_CHATS_FILE=telegram_chats.json
CODEX_TELEGRAM_STATE_FILE=codex_telegram_state.json

# Optional Obsidian-compatible memory vault. Defaults to LATTICEAI_BRAIN_DIR.
LATTICEAI_OBSIDIAN_VAULT_DIR=
