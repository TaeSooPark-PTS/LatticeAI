{
  "name": "ltcai",
  "displayName": "Lattice AI",
  "description": "Lattice AI extension for the local-first Digital Brain that keeps your knowledge durable across any AI model.",
  "version": "11.6.0",
  "publisher": "parktaesoo",
  "license": "MIT",
  "homepage": "https://github.com/TaeSooPark-PTS/LatticeAI#readme",
  "bugs": {
    "url": "https://github.com/TaeSooPark-PTS/LatticeAI/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "workspace",
    "pipeline",
    "knowledge-graph",
    "local-ai",
    "coding",
    "mlx",
    "mcp",
    "workflow",
    "copilot",
    "chat",
    "apple-silicon",
    "openai",
    "groq",
    "ollama",
    "graph-rag"
  ],
  "activationEvents": [
    "onCommand:ltcai.chat",
    "onCommand:ltcai.loadModel",
    "onCommand:ltcai.editSelection",
    "onCommand:ltcai.explainSelection",
    "onCommand:ltcai.refactorSelection",
    "onCommand:ltcai.generateTests",
    "onCommand:ltcai.sendToLattice",
    "onCommand:ltcai.askCurrentFile",
    "onCommand:ltcai.createFile",
    "onCommand:ltcai.runTerminal",
    "onCommand:ltcai.garden",
    "onCommand:ltcai.showGarden",
    "onCommand:ltcai.attachFile",
    "onCommand:ltcai.showSyncStatus",
    "onCommand:ltcai.listApprovals",
    "onCommand:ltcai.approveAgent",
    "onCommand:ltcai.rejectAgent",
    "onCommand:ltcai.askBrain",
    "onCommand:ltcai.reviewCenter",
    "onCommand:ltcai.runAgent",
    "onCommand:ltcai.evidenceActions",
    "onCommand:ltcai.runAgentLive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ltcai.chat",
        "title": "Lattice AI: Open Chat"
      },
      {
        "command": "ltcai.loadModel",
        "title": "Lattice AI: Load Model"
      },
      {
        "command": "ltcai.editSelection",
        "title": "Lattice AI: Edit Selection"
      },
      {
        "command": "ltcai.explainSelection",
        "title": "Lattice AI: Explain Selection"
      },
      {
        "command": "ltcai.refactorSelection",
        "title": "Lattice AI: Refactor Selection"
      },
      {
        "command": "ltcai.generateTests",
        "title": "Lattice AI: Generate Tests"
      },
      {
        "command": "ltcai.sendToLattice",
        "title": "Lattice AI: Send To Lattice"
      },
      {
        "command": "ltcai.askCurrentFile",
        "title": "Lattice AI: Ask About Current File"
      },
      {
        "command": "ltcai.createFile",
        "title": "Lattice AI: Create File"
      },
      {
        "command": "ltcai.runTerminal",
        "title": "Lattice AI: Generate Terminal Command"
      },
      {
        "command": "ltcai.garden",
        "title": "Lattice AI: Save to Knowledge Garden"
      },
      {
        "command": "ltcai.showGarden",
        "title": "Lattice AI: Show Knowledge Garden"
      },
      {
        "command": "ltcai.attachFile",
        "title": "Lattice AI: Attach Current File to Chat"
      },
      {
        "command": "ltcai.showSyncStatus",
        "title": "Lattice AI: Show Sync Status"
      },
      {
        "command": "ltcai.listApprovals",
        "title": "Lattice AI: List Pending Approvals"
      },
      {
        "command": "ltcai.approveAgent",
        "title": "Lattice AI: Approve Agent Run"
      },
      {
        "command": "ltcai.rejectAgent",
        "title": "Lattice AI: Reject Agent Run"
      },
      {
        "command": "ltcai.askBrain",
        "title": "Lattice AI: Ask Your Brain"
      },
      {
        "command": "ltcai.reviewCenter",
        "title": "Lattice AI: Review Center (Change Proposals)"
      },
      {
        "command": "ltcai.runAgent",
        "title": "Lattice AI: Run Agent Task"
      },
      {
        "command": "ltcai.evidenceActions",
        "title": "Lattice AI: Build From This Evidence"
      },
      {
        "command": "ltcai.runAgentLive",
        "title": "Lattice AI: Run Agent Task (Live Steps)"
      },
      {
        "command": "ltcai.captureFolder",
        "title": "Lattice AI: Capture Folder Into Brain"
      },
      {
        "command": "ltcai.showArtifacts",
        "title": "Lattice AI: Show Run Artifacts"
      }
    ],
    "configuration": {
      "title": "Lattice AI",
      "properties": {
        "ltcai.serverUrl": {
          "type": "string",
          "default": "http://localhost:4825",
          "description": "Lattice AI server base URL."
        },
        "ltcai.autoLoadModel": {
          "type": "boolean",
          "default": false,
          "description": "Load default model on extension activation."
        },
        "ltcai.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model id to auto-load."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "build": "tsc -p .",
    "package": "vsce package --out ../dist/ltcai-$npm_package_version.vsix",
    "package:vsix": "vsce package --out ../dist/ltcai-$npm_package_version.vsix",
    "publish:vscode": "vsce publish --packagePath ../dist/ltcai-$npm_package_version.vsix",
    "publish:openvsx": "ovsx publish ../dist/ltcai-$npm_package_version.vsix",
    "publish:all": "npm run build && npm run package:vsix && npm run publish:vscode && npm run publish:openvsx",
    "install:all": "bash ./scripts/install-all-editors.sh"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^0.10.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TaeSooPark-PTS/LatticeAI.git"
  },
  "pricing": "Free"
}
